diff --git a/StikDebug/Services/TunnelManager.swift b/StikDebug/Services/TunnelManager.swift
index 0249202..8845293 100644
--- a/StikDebug/Services/TunnelManager.swift
+++ b/StikDebug/Services/TunnelManager.swift
@@ -5,6 +5,42 @@

 import Foundation

+private let xmrandHandoffTraceQueue = DispatchQueue(label: "org.xmrand.stikdebug.xmrand-trace")
+
+func resetXMRAndHandoffTrace() {
+    xmrandHandoffTraceQueue.async {
+        let url = URL.documentsDirectory.appendingPathComponent("xmrand_handoff.log")
+        try? Data().write(to: url, options: .atomic)
+    }
+}
+
+func appendXMRAndHandoffTrace(_ message: String) {
+    let safeMessage = message.replacingOccurrences(of: "\n", with: " ")
+    xmrandHandoffTraceQueue.async {
+        let url = URL.documentsDirectory.appendingPathComponent("xmrand_handoff.log")
+        let timestamp = ISO8601DateFormatter().string(from: Date())
+        guard let data = "\(timestamp) \(safeMessage)\n".data(using: .utf8) else {
+            return
+        }
+
+        if !FileManager.default.fileExists(atPath: url.path) {
+            try? data.write(to: url, options: .atomic)
+            return
+        }
+
+        guard let handle = try? FileHandle(forWritingTo: url) else {
+            return
+        }
+        defer { try? handle.close() }
+        do {
+            try handle.seekToEnd()
+            try handle.write(contentsOf: data)
+        } catch {
+            return
+        }
+    }
+}
+
